# Required pipeline settings
JINA_API_KEY=jina_xxx
OPENROUTER_API_KEY=sk-or-xxx
TYPESAFE_API_KEY=typesafe_xxx
JOB_FINDER_IMPLEMENTATION_REF=local

# Local Compose database settings
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Native-development PostgreSQL. Compose replaces these with container-safe URLs.
JOB_FINDER_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/job_finder
JOB_FINDER_DAGSTER_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/job_finder?options=-csearch_path%3Ddagster
JOB_FINDER_TEST_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/job_finder

# Required review-app settings
JOB_FINDER_REVIEW_SESSION_SECRET=
JOB_FINDER_BOOTSTRAP_TOKEN=
JOB_FINDER_REVIEW_COOKIE_SECURE=false
# Compose replaces this with the private Dagster service URL.
JOB_FINDER_DAGSTER_GRAPHQL_URL=http://127.0.0.1:3000/graphql

# One-startup compatibility for installations upgrading from environment passwords
# JOB_FINDER_REVIEW_PASSWORD=your-existing-owner-password

# Pipeline tuning
ENABLE_ATS_ENRICHMENT=true
JOB_FINDER_SEARCH_WORKER_COUNT=8
JOB_FINDER_WORK_BATCH_SIZE=100
JOB_FINDER_WORK_LEASE_SECONDS=3600
JOB_FINDER_WORK_RETRY_SECONDS=300

# Optional observability
# JOB_FINDER_DISCOVERY_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/xxx
# JOB_FINDER_WORK_QUEUE_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/xxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
