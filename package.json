{
  "name": "jobfinder",
  "version": "2026.08.26",
  "description": "Automated job search and enrichment pipeline. Searches job boards, evaluates listings with an LLM, and stores qualified jobs in Notion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauricedesaxe/job-finder.git"
  },
  "keywords": [
    "job-search",
    "scraping",
    "notion",
    "llm",
    "automation",
    "openrouter"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "scrape": "bun src/index.ts",
    "reconcile": "bun src/index.ts --reconcile-only",
    "backfill:job-ledger": "bun scripts/backfill-job-ledger.ts",
    "prompts:bootstrap": "bun scripts/bootstrap-langsmith-prompts.ts",
    "prompts:release": "bun scripts/release-prompts.ts",
    "prompts:rollback": "bun scripts/rollback-prompts.ts",
    "test": "bun test __tests__",
    "test:integration": "bun test src/**/__integration__/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "test:d1-job-ledger": "bun test src/services/__tests__/d1JobLedger.test.ts",
    "check:cloudflare": "wrangler types --include-runtime false && wrangler deploy --dry-run --env=\"\" && wrangler deploy --dry-run --env production",
    "migrate:cloudflare:proof": "wrangler d1 migrations apply JOB_LEDGER --remote --env=\"\"",
    "migrate:cloudflare:production": "wrangler d1 migrations apply JOB_LEDGER --remote --env production",
    "deploy:cloudflare:proof": "bun run migrate:cloudflare:proof && wrangler deploy --env=\"\"",
    "deploy:cloudflare:production": "bun run migrate:cloudflare:production && wrangler deploy --env production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@cloudflare/workers-types": "5.20260820.1",
    "@evilmartians/lefthook": "2.1.4",
    "@types/bun": "1.3.11",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "@langchain/core": "1.2.3",
    "@langchain/openai": "1.5.5",
    "@notionhq/client": "2.3.0",
    "langchain": "1.5.4",
    "langsmith": "0.8.8",
    "pino": "^10.3.1",
    "zod": "4.3.6"
  }
}
