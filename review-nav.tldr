e:ar_back", "typeName": "shape", "type": "arrow", "parentId": "page:page1", "index": "azz0", "x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "props": {"dash": "draw", "size": "m", "fill": "none", "color": "black", "labelColor": "black", "bend": 40, "start": {"type": "binding", "boundShapeId": "shape:ejob_new", "normalizedAnchor": {"x": 0, "y": 0.5}, "isExact": false}, "end": {"type": "binding", "boundShapeId": "shape:etab_to", "normalizedAnchor": {"x": 0.1, "y": 1}, "isExact": false}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "text": "\u2190 back", "font": "draw"}}, {"id": "shape:n1", "typeName": "shape", "type": "note", "parentId": "page:page1", "index": "azz1", "x": 0, "y": 1690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "props": {"color": "yellow", "size": "m", "text": "Kill the revision copy. Current answer only. History stays in Postgres.", "font": "draw", "align": "middle", "verticalAlign": "middle", "growY": 0, "fontSizeAdjustment": 0, "url": "", "scale": 1, "labelColor": "black"}}, {"id": "shape:n2", "typeName": "shape", "type": "note", "parentId": "page:page1", "index": "azz2", "x": 260, "y": 1690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "props": {"color": "yellow", "size": "m", "text": "\u201cAudit\u201d \u2192 \u201cSecond look\u201d: the rejected sample we spot-check.", "font": "draw", "align": "middle", "verticalAlign": "middle", "growY": 0, "fontSizeAdjustment": 0, "url": "", "scale": 1, "labelColor": "black"}}, {"id": "shape:n3", "typeName": "shape", "type": "note", "parentId": "page:page1", "index": "azz3", "x": 520, "y": 1690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "props": {"color": "yellow", "size": "m", "text": "\u201cChoose the next move\u201d dies. The date is the title.", "font": "draw", "align": "middle", "verticalAlign": "middle", "growY": 0, "fontSizeAdjustment": 0, "url": "", "scale": 1, "labelColor": "black"}}, {"id": "shape:n4", "typeName": "shape", "type": "note", "parentId": "page:page1", "index": "azz4", "x": 780, "y": 1690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "props": {"color": "yellow", "size": "m", "text": "Arrows hop days that exist. \u201cToday\u201d snaps back.", "font": "draw", "align": "middle", "verticalAlign": "middle", "growY": 0, "fontSizeAdjustment": 0, "url": "", "scale": 1, "labelColor": "black"}}, {"id": "shape:n5", "typeName": "shape", "type": "note", "parentId": "page:page1", "index": "azz5", "x": 1040, "y": 1690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "props": {"color": "yellow", "size": "m", "text": "After a decision: next job, or back to the list?", "font": "draw", "align": "middle", "verticalAlign": "middle", "growY": 0, "fontSizeAdjustment": 0, "url": "", "scale": 1, "labelColor": "black"}}]}