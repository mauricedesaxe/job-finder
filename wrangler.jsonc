{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-finder-proof",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "d1_databases": [
    {
      "binding": "JOB_LEDGER",
      "database_name": "job-finder-ledger-proof",
      "database_id": "7666d4cf-af9e-43a2-8838-f0aa8b8dff25",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "job-finder-proof",
      "binding": "JOB_FINDER_WORKFLOW",
      "class_name": "JobFinderWorkflow"
    }
  ],
  "vars": {
    "ENABLE_ATS_ENRICHMENT": "true",
    "LOG_LEVEL": "info"
  },
  "env": {
    "production": {
      "name": "job-finder",
      "d1_databases": [
        {
          "binding": "JOB_LEDGER",
          "database_name": "job-finder-ledger",
          "database_id": "196a7110-b06f-4cdc-ad99-3ef30cfcdb2e",
          "migrations_dir": "migrations"
        }
      ],
      "workflows": [
        {
          "name": "job-finder",
          "binding": "JOB_FINDER_WORKFLOW",
          "class_name": "JobFinderWorkflow"
        }
      ],
      "vars": {
        "ENABLE_ATS_ENRICHMENT": "true",
        "LOG_LEVEL": "info"
      }
    }
  }
}
